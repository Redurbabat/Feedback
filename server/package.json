{
  "name": "@feedback/server",
  "version": "0.1.0",
  "private": true,
  "description": "Feedback control-plane server (auth, pairing, device registry)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrateCli.ts",
    "user:create": "tsx src/scripts/createUser.ts",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^5.0.0"
  }
}
