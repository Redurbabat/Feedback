# Feedback Server - Beispielkonfiguration
# Diese Datei enthaelt ausschliesslich Platzhalter. Echte Werte gehoeren in eine
# lokale .env (gitignored) oder in den Secret Store der Deployment-Umgebung.

# development | test | production
NODE_ENV=development

FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=8080

# SQLite-Datei fuer den MVP. Produktionsziel ist PostgreSQL; der Wechsel erfolgt
# hinter der Repository-Schicht (src/db/repositories).
FEEDBACK_DATABASE_FILE=./data/feedback.db

# PFLICHT. Mindestens 32 Zeichen. Kein Default im Code - fehlt der Wert,
# startet der Server nicht. Erzeugen z. B. mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FEEDBACK_COOKIE_SECRET=<32-byte-zufallswert-hier-einsetzen>

# PFLICHT. Kommagetrennte Liste der erlaubten Control-Center-Origins.
# Das ist die Adresse des CONTROL CENTERS im Browser - sie darf eine andere sein als die des
# API-Hosts. Deshalb ist sie keine Aussage darueber, wie DIESER Server heisst.
FEEDBACK_ALLOWED_ORIGINS=http://localhost:5173

# Optional: die oeffentliche Adresse DIESES Servers, nur fuer die Einrichtungsseite /pair.
# Dort steht sie als "Diese Seite gehoert zu: ..." - also als die Adresse, an der ein Besucher
# entscheidet, ob ein Einrichtungslink zu seinem Server gehoert. Genau deshalb wird sie streng
# geprueft, und zwar nach derselben Regel, die die App auf jede Serveradresse anwendet
# (ServerEndpoint.parse): https, ein registrierbarer Hostname (kein localhost, keine IP), kein
# Pfad, keine Zugangsdaten. Ein Wert, der das nicht erfuellt, bricht den Start ab - eine Adresse,
# die die App ohnehin ablehnt, darf die Seite nicht als Vergleichswert anbieten.
# Ein ausgeschriebener Port 443 wird entfernt, weil beide Seiten ihn weglassen.
# Nicht gesetzt heisst: die Seite nennt gar keine Adresse und sagt in einem Satz warum. Sie nennt
# nur dann von sich aus eine, wenn dieser Server das Control Center selbst ausliefert
# (FEEDBACK_STATIC_DIR) und genau eine erlaubte Origin als Adresse taugt - dann ist diese Origin
# zwangslaeufig dieser Server. Mit den Werten dieser Beispieldatei ist das nicht der Fall.
FEEDBACK_PUBLIC_ORIGIN=

# Optional: Lebensdauer einer Control-Center-Sitzung in Millisekunden (Standard 12 h).
FEEDBACK_SESSION_TTL_MS=43200000

# Optional: Obergrenze fuer einen einzelnen Download in Bytes (Standard 268435456).
# Darf nur gesenkt werden - das Protokoll deckelt den Wert, und das Geraet erzwingt
# zusaetzlich sein eigenes Limit. Der kleinere Wert gewinnt.
FEEDBACK_FILE_MAX_DOWNLOAD_BYTES=268435456

# Optional: das gebaute Control Center aus derselben Origin ausliefern.
# Gesetzt heisst: ein Ursprung fuer Browser und API. Das HttpOnly-Cookie braucht dann keine
# Ausnahme, es gibt kein CORS, und ein einziger Tunnel reicht fuer den ersten Test.
# Nicht gesetzt heisst: reine API - was ein Deployment mit eigenem Reverse Proxy will.
FEEDBACK_STATIC_DIR=../control-web/dist

# Optional: hinter einem Reverse Proxy auf true setzen, damit X-Forwarded-For
# fuer Rate Limits ausgewertet wird. Nur aktivieren, wenn der Proxy den Header setzt.
FEEDBACK_TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
FEEDBACK_LOG_LEVEL=info

# Optionaler Erstbenutzer beim allerersten Start (nur wenn noch kein Benutzer existiert).
# Bevorzugter Weg ist stattdessen: npm run user:create -- --email <adresse>
# NIEMALS ein echtes Passwort in eine eingecheckte Datei schreiben.
FEEDBACK_BOOTSTRAP_EMAIL=
FEEDBACK_BOOTSTRAP_PASSWORD=

# Optional: Android-App, fuer die dieser Server unter /.well-known/assetlinks.json buergt.
# Ohne Fingerabdruck wird die Datei nicht ausgeliefert (404) - ein Deployment, das keinen
# Schluessel benennen kann, behauptet auch nichts ueber einen.
# Wert: Ausgabe von `keytool -list -v -keystore <datei> -alias <alias>`, Zeile "SHA256:",
# also 32 Hex-Paare in Grossbuchstaben mit Doppelpunkten. Ein Tippfehler bricht den Start ab.
# Genau EIN Fingerabdruck. Beim Schluesselwechsel wird der Wert ersetzt, nicht ergaenzt:
# ein zusaetzlicher alter Fingerabdruck laesst einem verlorenen Schluessel eine verifizierte
# Beanspruchung dieser Domain.
FEEDBACK_ANDROID_CERT_SHA256=
FEEDBACK_ANDROID_PACKAGE=com.redurbabat.feedback

# Wo der eigene Identitaetsschluessel des Servers liegt. Ohne Angabe: identity.pem neben der
# Datenbank. Er entsteht beim ersten Start, hat Rechte 0600 und wird nie ersetzt - an ihm
# erkennen die gekoppelten Geraete diesen Server wieder. Zusammen mit der Datenbank sichern.
#FEEDBACK_SERVER_KEY_FILE=./data/identity.pem
