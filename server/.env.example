# Feedback Server - Beispielkonfiguration
# Diese Datei enthaelt ausschliesslich Platzhalter. Echte Werte gehoeren in eine
# lokale .env (gitignored) oder in den Secret Store der Deployment-Umgebung.

# development | test | production
NODE_ENV=development

FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=8080

# SQLite-Datei fuer den MVP. Produktionsziel ist PostgreSQL; der Wechsel erfolgt
# hinter der Repository-Schicht (src/db/repositories).
FEEDBACK_DATABASE_FILE=./data/feedback.db

# PFLICHT. Mindestens 32 Zeichen. Kein Default im Code - fehlt der Wert,
# startet der Server nicht. Erzeugen z. B. mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FEEDBACK_COOKIE_SECRET=<32-byte-zufallswert-hier-einsetzen>

# PFLICHT. Kommagetrennte Liste der erlaubten Control-Center-Origins.
FEEDBACK_ALLOWED_ORIGINS=http://localhost:5173

# Optional: Lebensdauer einer Control-Center-Sitzung in Millisekunden (Standard 12 h).
FEEDBACK_SESSION_TTL_MS=43200000

# Optional: hinter einem Reverse Proxy auf true setzen, damit X-Forwarded-For
# fuer Rate Limits ausgewertet wird. Nur aktivieren, wenn der Proxy den Header setzt.
FEEDBACK_TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
FEEDBACK_LOG_LEVEL=info

# Optionaler Erstbenutzer beim allerersten Start (nur wenn noch kein Benutzer existiert).
# Bevorzugter Weg ist stattdessen: npm run user:create -- --email <adresse>
# NIEMALS ein echtes Passwort in eine eingecheckte Datei schreiben.
FEEDBACK_BOOTSTRAP_EMAIL=
FEEDBACK_BOOTSTRAP_PASSWORD=
